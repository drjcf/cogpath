# Copy to .env
MODEL_API_KEY=            # Anthropic API key (console.anthropic.com → API keys); ANTHROPIC_API_KEY also works locally
# COGPATH_MODEL=claude-sonnet-5-5
# COGPATH_DATA=runs       # where run JSON is written
# MOCK_LLM=1              # no API calls; deterministic artifacts for pipeline/UI work
# LLM_TIMEOUT_MS=600000
# LLM_MAX_RETRIES=2
# LLM_MAX_OUTPUT_TOKENS=16384      # max_tokens per call (thinking and answer together); truncation retries once at 2x
# LLM_MAX_OUTPUT_TOKENS_CAP=64000  # ceiling for that retry; keep at or below the model's output limit

# Prompt cache TTL for the source prefix: 5m (default, refreshed on each hit) | 1h (writes cost 2x) | none
# LLM_CACHE_TTL=5m

# ── cloud shape (set by deploy/deploy.sh on Cloud Run; set locally to run the CLI against the cloud store) ──
# COGPATH_STORE=gcp                 # fs (default: runs/ on disk) | gcp (Firestore + Cloud Storage)
# GOOGLE_CLOUD_PROJECT=edai-prep
# COGPATH_FIRESTORE_DB=cogpath      # named Firestore database
# COGPATH_BUCKET=edai-prep-cogpath
# COGPATH_AUTH=firebase             # firebase (default with gcp) | none (local: reviewer name header)
# COGPATH_ALLOWLIST=you@example.com # comma-separated emails that may upload, review, approve, build (plus the allowlist collection)
# COGPATH_JOB_RUNNER=cloudrun       # cloudrun (needs COGPATH_WORKER_JOB) | local (child process)
# COGPATH_WORKER_JOB=projects/edai-prep/locations/us-central1/jobs/cogpath-worker
# COGPATH_FIREBASE_WEB_CONFIG={"apiKey":"…","authDomain":"edai-prep.firebaseapp.com","projectId":"edai-prep","appId":"…"}
